# Copy this file to .env and fill in the real Supabase connection string.
# NEVER commit .env (it is git-ignored). See README for Supabase dashboard steps.
# Use the Session Pooler connection string from Supabase Dashboard -> Connect
# if your network is IPv4-only; otherwise a direct connection works too.
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@[POOLER-HOST]:5432/postgres
